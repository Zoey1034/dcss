  <diagram name="文档处理流程图" id="document-process-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="智能文档分类系统 - 文档处理流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="184" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- 开始 -->
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="534" y="80" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- 步骤1: 用户上传文件 -->
        <mxCell id="step1" value="1. 用户上传文件&#xa;(FileController.addFile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="170" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 步骤2: 保存到MinIO和数据库 -->
        <mxCell id="step2" value="2. 保存文件到 MinIO&#xa;(AiFileService)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="260" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 步骤3: 调用AI服务 -->
        <mxCell id="step3" value="3. 调用 AI 服务处理&#xa;(DocumentProcessBusiness)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="484" y="350" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- AI服务判断 -->
        <mxCell id="aiDecision" value="AI 处理&#xa;成功?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="509" y="440" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- 失败分支: 清理文件 -->
        <mxCell id="cleanupStep" value="清理 MinIO 文件&#xa;和数据库记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="260" y="455" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- 步骤4: 持久化结果 -->
        <mxCell id="step4" value="4. 持久化 AI 结果&#xa;(AiResultPersistenceService)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="550" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- 步骤5: 人工审核 -->
        <mxCell id="step5" value="5. 人工审核&#xa;(ReviewController)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
